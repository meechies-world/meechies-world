{
  "name": "Meechie's World",
  "short_name": "Meechie's World",
  "description": "Live radio, MW TV, Meechie's Book, the shop and more, in one free app. Installs on your phone or computer, no app store needed.",
  "start_url": "/?source=app",
  "display": "standalone",
  "background_color": "#0b0a08",
  "theme_color": "#0b0a08",
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "orientation": "any",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "music",
    "social",
    "entertainment",
    "shopping"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Radio",
      "short_name": "Radio",
      "url": "/?source=app#radio",
      "icons": [
        {
          "src": "/img/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "MW TV",
      "short_name": "MW TV",
      "url": "/?source=app#mwtv",
      "icons": [
        {
          "src": "/img/apps/tv-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Meechie's Book",
      "short_name": "Book",
      "url": "/?source=app#community",
      "icons": [
        {
          "src": "/img/apps/book-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Shop",
      "short_name": "Shop",
      "url": "/?source=app#shop",
      "icons": [
        {
          "src": "/img/apps/shop-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/img/app/shot-phone-home.webp",
      "sizes": "1170x1992",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Home: live radio and MW TV"
    },
    {
      "src": "/img/app/shot-phone-shop.webp",
      "sizes": "1170x1992",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The shop"
    },
    {
      "src": "/img/app/shot-wide-home.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Meechie's World on a computer"
    }
  ]
}